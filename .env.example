# ==============================================================================
# DASDAD / NovaPay - Environment Variables Reference
# ==============================================================================

# Database: MongoDB Atlas Connection URI
# Example: mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/dasdad?retryWrites=true&w=majority
MONGODB_URI=

# Authentication: JWT secret key (generate with: openssl rand -hex 32)
JWT_SECRET=super-secret-jwt-key-change-in-production

# App URL: Base public URL for redirects, payment links and checkout flows
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: Email / SMTP service configuration
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=user@example.com
# SMTP_PASSWORD=secret
# SMTP_FROM="NovaPay" <noreply@yourdomain.com>
